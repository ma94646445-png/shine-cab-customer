# SHINE CAB — Environment Configuration
# Copy this file to .env and configure values in your secure environment.
# NEVER commit real secrets to version control.

# Supabase Project (Auth, PostgreSQL, Realtime)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform (Maps JS, Places New, Routes, Geocoding)
GOOGLE_MAPS_API_KEY=

# Razorpay Payments (Server-Side Order Creation, Signature & Webhook Verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
FIREBASE_SERVER_KEY=

# Application Base URL
APP_BASE_URL=
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
